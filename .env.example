# Backend the Next.js proxy forwards /api/theProfessionalNetwork/lms/* to.
NEXT_PUBLIC_API_BASE_URL=https://pretest.elred.io/api/theProfessionalNetwork/lms
API_ORIGIN=https://pretest.elred.io/api/theProfessionalNetwork/lms

# Google sign-in (OAuth "Web application" client ID).
# Must be the SAME client ID the backend uses (LMS_GOOGLE_CLIENT_ID), and this
# front-end's origin must be listed under "Authorized JavaScript origins".
# Defaults to the LMS client below; set "off" to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=927723428529-qbl5a61slf41uq5mi0nd7h80ubnmljod.apps.googleusercontent.com

# Realtime (comments/questions). Socket.io on the backend at path /lms-socket.io.
# Defaults to the origin of NEXT_PUBLIC_API_BASE_URL. Set to "off" to disable.
NEXT_PUBLIC_SOCKET_URL=https://pretest.elred.io
